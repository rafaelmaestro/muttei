{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muttei",
  "version": "0.7.0",
  "identifier": "app.muttei",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "wireplumber",
          "pipewire-bin",
          "libglib2.0-bin",
          "sound-theme-freedesktop"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NDM1Njk5MUU0QkQ5NjEKUldSaDJVc2VtVlpEdWNhOFZPenpPNWx2TzJGS2ZYRlRJNFRseGhyVjNVbG1BVnRZemJjSUJrWWMK",
      "endpoints": [
        "https://github.com/rafaelmaestro/muttei/releases/latest/download/latest.json"
      ]
    }
  }
}
