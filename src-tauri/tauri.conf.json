{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muttei",
  "version": "0.2.0",
  "identifier": "app.muttei",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "wireplumber",
          "pipewire-bin",
          "libglib2.0-bin",
          "sound-theme-freedesktop"
        ]
      }
    }
  }
}
