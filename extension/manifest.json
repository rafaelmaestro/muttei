{
  "manifest_version": 3,
  "name": "Muttei",
  "version": "0.1.0",
  "description": "Faz o ícone de microfone do Google Meet acompanhar o Muttei.",
  "icons": { "32": "icon32.png", "128": "icon128.png" },
  "action": { "default_title": "Muttei", "default_icon": { "32": "icon32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
